{
  "name": "@vault/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/migrate-deploy.mjs && tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node scripts/migrate-deploy.mjs && node dist/server.js",
    "start:prod": "node scripts/migrate-deploy.mjs && node dist/server.js",
    "db:migrate": "node scripts/migrate-deploy.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:seed": "tsx prisma/seed.ts",
    "db:admin": "tsx prisma/create-admin.ts",
    "db:reset": "node -e \"if(process.env.NODE_ENV==='production'){console.error('Refusing to reset in production');process.exit(1)}\" && prisma migrate reset --force",
    "db:reset:data": "node -e \"if(process.env.NODE_ENV==='production'){console.error('Refusing to wipe data in production');process.exit(1)}\" && psql \"$DATABASE_URL\" -f prisma/reset.sql && pnpm db:seed",
    "test": "pnpm build && node --test \"test/**/*.test.mjs\""
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.19.3",
    "@vault/shared": "workspace:*",
    "fastify": "^5.2.0",
    "fastify-plugin": "^6.0.0",
    "jose": "^6.2.3",
    "prisma": "6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
