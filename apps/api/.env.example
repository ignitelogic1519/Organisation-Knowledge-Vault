# Copy to .env for local development. On Render, set these in the dashboard.

# Neon Postgres connection string (local dev: any Postgres works)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Allowed browser origin for CORS (the Vercel URL in production)
WEB_ORIGIN="http://localhost:3000"

# Secret for signing JWT access tokens — required in production (Render generates one)
JWT_SECRET=""

# Secret protecting POST /jobs/run (shared with the GitHub Actions nightly workflow)
JOB_SECRET=""

# Inactivity that ends a session, in minutes (docs/structure.md §8.8). Default 60;
# clamped to 5 minutes–7 days. Applies to user sessions AND the staff console.
# SESSION_IDLE_MINUTES=60

# Supreme-gate rate limit overrides for testing phases (defaults: 5 attempts / 15 minutes)
# SUPREME_MAX_ATTEMPTS=100
# SUPREME_WINDOW_MINUTES=1

# Local API port (Render injects PORT automatically in production)
PORT=4000

# Encrypts organizations' storage credentials and wraps their per-org data keys.
# 32 bytes as hex. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production. Locally, leaving it blank derives a throwaway dev key.
# NEVER reuse the production value here, and never commit a real one.
STORAGE_KEK=""

# ── Google Drive storage (docs/structure.md §9.16) ─────────────────────────────
# An OAuth "Web application" client from Google Cloud (docs/storage-setup-guide.md,
# "Switching on Google Drive"). Its authorized redirect URI must be
#   <API_PUBLIC_URL>/storage/google/callback   e.g. http://localhost:4000/storage/google/callback
# Leave both empty and Google Drive shows as "not switched on".
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# This API's public address (for the redirect URI). Render sets RENDER_EXTERNAL_URL,
# which is used when this is empty; locally it falls back to http://localhost:PORT.
# API_PUBLIC_URL="http://localhost:4000"

# A separate streaming gateway (apps/api/src/stream-server.ts). Empty: the gateway runs
# in this process under a 2 GiB monthly budget. Set: tickets point there, budget 9.5 TiB.
# STREAM_GATEWAY_URL="https://stream.example.com"
# STREAM_MONTHLY_LIMIT_BYTES=2147483648
# STREAM_ORG_MONTHLY_LIMIT_BYTES=2147483648
# STREAM_TICKET_SECRET=""   # derived from STORAGE_KEK when empty

# Walk the whole Google Drive flow locally without a Google account:
#   node test/fake-google.mjs      (in apps/api; listens on :4999)
# then uncomment these, and use GOOGLE_OAUTH_CLIENT_ID=fake-client and
# GOOGLE_OAUTH_CLIENT_SECRET=fake-secret above. Ignored in production.
# GOOGLE_AUTH_URL=http://localhost:4999/o/oauth2/v2/auth
# GOOGLE_TOKEN_URL=http://localhost:4999/token
# GOOGLE_REVOKE_URL=http://localhost:4999/revoke
# GOOGLE_DRIVE_API=http://localhost:4999/drive/v3
# GOOGLE_DRIVE_UPLOAD=http://localhost:4999/upload/drive/v3
