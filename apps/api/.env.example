# Copy to .env for local development. On Render, set these in the dashboard.

# Neon Postgres connection string (local dev: any Postgres works)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Allowed browser origin for CORS (the Vercel URL in production)
WEB_ORIGIN="http://localhost:3000"

# Public web URL used inside email verification links (defaults to WEB_ORIGIN)
WEB_URL="http://localhost:3000"

# Secret for signing JWT access tokens — required in production (Render generates one)
JWT_SECRET=""

# Optional: Google sign-in (OAuth client ID from Google Cloud console)
GOOGLE_CLIENT_ID=""

# Optional: platform Gmail for verification emails (App Password, requires 2FA on the account).
# Leave empty in dev — verification links are logged to the API console instead.
SMTP_USER=""
SMTP_PASS=""

# Local API port (Render injects PORT automatically in production)
PORT=4000
