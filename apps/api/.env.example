# Copy to .env for local development. On Render, set these in the dashboard.

# Neon Postgres connection string (local dev: any Postgres works)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Allowed browser origin for CORS (the Vercel URL in production)
WEB_ORIGIN="http://localhost:3000"

# Secret for signing JWT access tokens — required in production (Render generates one)
JWT_SECRET=""

# Secret protecting POST /jobs/run (shared with the GitHub Actions nightly workflow)
JOB_SECRET=""

# Inactivity that ends a session, in minutes (docs/structure.md §8.8). Default 60;
# clamped to 5 minutes–7 days. Applies to user sessions AND the staff console.
# SESSION_IDLE_MINUTES=60

# Supreme-gate rate limit overrides for testing phases (defaults: 5 attempts / 15 minutes)
# SUPREME_MAX_ATTEMPTS=100
# SUPREME_WINDOW_MINUTES=1

# Local API port (Render injects PORT automatically in production)
PORT=4000

# Encrypts organizations' storage credentials and wraps their per-org data keys.
# 32 bytes as hex. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production. Locally, leaving it blank derives a throwaway dev key.
# NEVER reuse the production value here, and never commit a real one.
STORAGE_KEK=""
