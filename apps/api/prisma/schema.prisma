// Knowledge Vault data model — the DB contract from docs/architecture.md §3.
// Phase 0 ships the schema only; the first migration runs in Phase 1 against Neon.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlacementKind {
  OWNER
  MEMBER
}

enum CourseKind {
  DOCUMENT
  BOOK
  LINK
  AUDIO
  VIDEO
  // EXAM arrives post-v1 (docs/future.md §5b)
}

enum CompletionStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  EXPIRED
}

enum AccessLevel {
  VIEW
  EDIT
}

// Organization-standard document classification — compulsory on every course.
enum Classification {
  PUBLIC
  CONFIDENTIAL
  PRIVATE
  SECRET
}

enum RequestKind {
  COURSE_ASSIGN // "Course request" — assign a library course to the requester's branch
  JOIN_BRANCH // "Join request" — be added as member of a public branch
  DELETE_BRANCH // "Deletion request" — branch owners asking the layer above to delete it
  VISIBILITY // "Visibility request" — unhide the chain above so a public branch shows
  CONTENT_REVIEW // "Document review" — a member's draft awaiting manager approval to publish
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// ── Identity ────────────────────────────────────────────────────────────────

// Identity is username-based (owner decision 2026-07-19 — email system removed from v1,
// see docs/future.md §10). Existing rows keep their data: the old email string IS the username.
model Profile {
  id           String       @id @default(uuid())
  username     String       @unique
  passwordHash String?
  displayName  String
  createdAt    DateTime     @default(now())
  memberships  Membership[]
  refreshTokens RefreshToken[]
}

// Opaque rotating refresh tokens — only the hash is stored (architecture.md §8)
model RefreshToken {
  id        String    @id @default(uuid())
  profileId String
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([profileId])
}


// ── Organization / Supreme ─────────────────────────────────────────────────

model Organization {
  id             String       @id @default(uuid())
  name           String
  orgNumber      Int          @unique // platform-unique, NEVER reused (global sequence)
  supremeHash    String // Argon2id of the Supreme password
  nextRoleNumber Int          @default(101) // per-org role counter, NEVER reused
  deletedAt      DateTime? // soft delete; purge job after 30 days
  createdAt      DateTime     @default(now())
  roles          RoleNode[]
  memberships    Membership[]
  courses        Course[]
  supremeAudits  SupremeAudit[]
}

// Audit trail of Supreme-gate activity — the Supreme itself performs no actions, so every
// use of its password is recorded (docs/architecture.md §8).
model SupremeAudit {
  id             String       @id @default(uuid())
  orgId          String
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  action         String // verify_success | verify_failed | owner_added | owner_removed
  actorProfileId String?
  ip             String?
  detail         String?
  createdAt      DateTime     @default(now())

  @@index([orgId, createdAt])
}

model RoleNode {
  id           String       @id @default(uuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id])
  parentId     String? // null only for the Owner role
  name         String // "HR", "Owner", "CEO", …
  roleNumber   Int // unique within org, NEVER reused
  isPublic     Boolean      @default(true) // public by default; hiding is the explicit
  // choice. EFFECTIVE visibility also requires every ancestor below the root to be
  // public — hidden inherits down to the last end. Owners above a hidden node always
  // still see it (hierarchy transparency).
  path         String // materialized path built from role numbers, e.g. "100.101"
  nextItemNumber Int        @default(1) // per-role course item counter, NEVER reused
  placements   Placement[]

  @@unique([orgId, roleNumber])
  @@index([orgId, path])
}

model Membership {
  id         String       @id @default(uuid())
  profileId  String
  profile    Profile      @relation(fields: [profileId], references: [id])
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id])
  createdAt  DateTime     @default(now())
  placements Placement[]

  @@unique([profileId, orgId])
}

model Placement {
  id                 String        @id @default(uuid())
  membershipId       String
  membership         Membership    @relation(fields: [membershipId], references: [id])
  roleNodeId         String
  roleNode           RoleNode      @relation(fields: [roleNodeId], references: [id])
  kind               PlacementKind
  canCreateSubgroups Boolean       @default(false) // meaningful for OWNER
  canAddCoOwners     Boolean       @default(false) // OWNER only: may appoint co-owners here
  canCreateContent   Boolean       @default(false) // MEMBER: may propose content (needs review)
  addedByProfileId   String // escalation target (docs/structure.md §3.4)
  createdAt          DateTime      @default(now())

  @@unique([membershipId, roleNodeId, kind])
}

// ── Courses ────────────────────────────────────────────────────────────────

model Course {
  id                       String             @id @default(uuid())
  orgId                    String
  org                      Organization       @relation(fields: [orgId], references: [id])
  code                     String             @unique // "456-989-0001"
  uploaderRoleNodeId       String
  createdByProfileId       String
  kind                     CourseKind
  title                    String
  description              String? // short description shown in the library and admin views
  inLibrary                Boolean            @default(false) // discoverable in the org library
  category                 String? // dynamic shelf tag ("AI", "Safety", …) — suggested from
  // existing categories at upload time, always changeable by the uploader
  scope                    String? // page-2 "scope" of the standardized document format
  classification           Classification     @default(CONFIDENTIAL) // compulsory org standard
  allowDownload            Boolean            @default(false) // owner-controlled download from preview
  archived                 Boolean            @default(false) // archived: kept, but reaches nobody new
  draft                    Boolean            @default(false) // member proposal pending manager review
  storageRef               Json // adapter-specific pointer: {adapter:"inline"|"link", ...}
  deadlineDays             Int?
  retakeEveryNDays         Int? // recurrence, applies to all kinds
  resetsCompletionOnUpdate Boolean            @default(false)
  version                  Int                @default(1)
  createdAt                DateTime           @default(now())
  placements               CoursePlacement[]
  prerequisites            CoursePrerequisite[] @relation("course")
  requiredBy               CoursePrerequisite[] @relation("requires")
  adminAccess              CourseAdminAccess[]
  reviews                  CourseReview[]
}

model CoursePlacement {
  id                   String   @id @default(uuid())
  courseId             String
  course               Course   @relation(fields: [courseId], references: [id])
  roleNodeId           String
  mandatory            Boolean
  inheritToDescendants Boolean
  deadlineDays         Int? // per-branch override of the course default
  retakeEveryNDays     Int? // per-branch recurrence override
  placedByProfileId    String
  createdAt            DateTime @default(now()) // deadline anchor

  @@unique([courseId, roleNodeId])
}

// Inline storage adapter backend: small files kept in Postgres (free-tier friendly).
// Media at scale goes through other adapters (Drive/NAS/S3 — the port stays open).
model StoredFile {
  id        String   @id @default(uuid())
  orgId     String
  filename  String
  mime      String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  @@index([orgId])
}

model CoursePrerequisite {
  courseId         String
  course           Course @relation("course", fields: [courseId], references: [id])
  requiresCourseId String
  requires         Course @relation("requires", fields: [requiresCourseId], references: [id])

  @@id([courseId, requiresCourseId])
}

model CourseAdminAccess {
  id        String      @id @default(uuid())
  courseId  String
  course    Course      @relation(fields: [courseId], references: [id])
  profileId String
  level     AccessLevel
  canGrant  Boolean // 2-layer tree: may add more people to this page
  grantedBy String

  @@unique([courseId, profileId])
}

// After completing a course a member may rate it (1–5, optional) and leave a comment
// other members see on the library detail view.
model CourseReview {
  id        String   @id @default(uuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  profileId String
  rating    Int? // 1..5, optional
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, profileId])
  @@index([courseId])
}

// ── Compliance ─────────────────────────────────────────────────────────────

// Part of the USER's data, keyed by course code (docs/structure.md §3.7).
model CompletionRecord {
  id            String           @id @default(uuid())
  courseId      String
  courseCode    String // denormalized platform-unique code, survives exports
  profileId     String
  orgId         String
  status        CompletionStatus
  completedAt   DateTime?
  validUntil    DateTime? // expiry: completedAt + retakeEveryNDays
  courseVersion Int
  // exam fields (score, pass/fail, re-attempt time) join here post-v1

  @@index([profileId, orgId])
  @@index([courseCode])
}

// Pending placements for usernames without a profile yet — used by .main revival
// (pending members re-attach when that username registers).
model Invitation {
  id                 String        @id @default(uuid())
  orgId              String
  username           String
  roleNodeId         String
  kind               PlacementKind
  canCreateSubgroups Boolean       @default(false)
  canAddCoOwners     Boolean       @default(false)
  canCreateContent   Boolean       @default(false)
  invitedByProfileId String
  acceptedAt         DateTime?
  createdAt          DateTime      @default(now())

  @@index([username])
  @@index([orgId, roleNodeId])
}

// Every ask-and-approve flow on the platform: course requests from the library,
// join requests to public branches, and branch-deletion requests to the layer above.
model VaultRequest {
  id                 String        @id @default(uuid())
  orgId              String
  kind               RequestKind
  status             RequestStatus @default(PENDING)
  requesterProfileId String
  targetRoleNodeId   String // branch to join / branch to delete / branch receiving the course
  joinAs             PlacementKind @default(MEMBER) // JOIN_BRANCH only: member or sub-owner
  courseId           String? // COURSE_ASSIGN only
  message            String?
  decidedByProfileId String?
  decidedAt          DateTime?
  decisionNote       String?
  createdAt          DateTime      @default(now())

  @@index([orgId, status])
  @@index([requesterProfileId])
}

model Notification {
  id        String    @id @default(uuid())
  profileId String
  orgId     String?
  kind      String
  payload   Json
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([profileId, readAt])
}
