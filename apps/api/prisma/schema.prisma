// Knowledge Vault data model — the DB contract from docs/architecture.md §3.
// Phase 0 ships the schema only; the first migration runs in Phase 1 against Neon.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlacementKind {
  OWNER
  MEMBER
}

enum CourseKind {
  DOCUMENT
  BOOK
  LINK
  AUDIO
  VIDEO
  EXAM // MCQ test built in the Studio — marked by the server, see ExamAttempt
}

// How a course's content entered the vault — the two metered allowances on a plan.
enum ContentSource {
  STUDIO // built block-by-block in the Document Studio ("custom document")
  UPLOAD // a file uploaded into the vault, or an external link registered as content
}

enum CompletionStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  EXPIRED
}

enum AccessLevel {
  VIEW
  EDIT
}

// Organization-standard document classification — compulsory on every course.
enum Classification {
  PUBLIC
  CONFIDENTIAL
  PRIVATE
  SECRET
}

enum RequestKind {
  COURSE_ASSIGN // "Course request" — assign a library course to the requester's branch
  JOIN_BRANCH // "Join request" — be added as member of a public branch
  DELETE_BRANCH // "Deletion request" — branch owners asking the layer above to delete it
  VISIBILITY // "Visibility request" — unhide the chain above so a public branch shows
  CONTENT_REVIEW // "Document review" — a member's draft awaiting manager approval to publish
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// ── Identity ────────────────────────────────────────────────────────────────

// Identity is username-based (owner decision 2026-07-19 — email system removed from v1,
// see docs/future.md §10). Existing rows keep their data: the old email string IS the username.
model Profile {
  id           String       @id @default(uuid())
  username     String       @unique
  passwordHash String?
  displayName  String
  avatar       String? // small data-URL profile picture (optional)
  /// Signed out everywhere and refused at login. Reversible, and deliberately not a
  /// delete: a banned person's completion records and audit trail stay intact.
  bannedAt     DateTime?
  // Knowledge Coins — the platform's virtual currency for buying plans. Every new
  // profile starts with 150. Only visible on the pricing/payment page (docs/pricing.md).
  coins        Int          @default(150)
  createdAt    DateTime     @default(now())
  memberships  Membership[]
  refreshTokens RefreshToken[]
  coinTxns     CoinTransaction[]
  platformRequests PlatformRequest[]
}

// Tamper-evident record of sensitive governance actions (people, courses, requests,
// backups, deletions). Append-only; the nightly job trims entries past retention.
model AuditLog {
  id             String   @id @default(uuid())
  orgId          String
  actorProfileId String?
  action         String // e.g. "person.add" | "course.delete" | "request.decide"
  detail         Json?
  ip             String?
  createdAt      DateTime @default(now())

  @@index([orgId, createdAt])
}

// Opaque rotating refresh tokens — only the hash is stored (architecture.md §8)
model RefreshToken {
  id        String    @id @default(uuid())
  profileId String
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([profileId])
}


// ── Organization / Supreme ─────────────────────────────────────────────────

model Organization {
  id             String       @id @default(uuid())
  name           String
  orgNumber      Int          @unique // platform-unique, NEVER reused (global sequence)
  supremeHash    String // Argon2id of the Supreme password
  nextRoleNumber Int          @default(101) // per-org role counter, NEVER reused
  deletedAt      DateTime? // soft delete; purge job after 30 days
  createdAt      DateTime     @default(now())
  // ── Plan / subscription state (the Supreme's authoritative record) ──────────
  // The plan/expiry that drives the org-card timer and the create/restore gates.
  // Held on the server row so the super-admin can change it (the Supreme *password*
  // is unknown to the server); a signed snapshot is also written into the .main file
  // for the revive-after-purge case. planStatus NONE = legacy/grandfathered (pre-plan
  // orgs keep working with no timer). See docs/pricing.md.
  planKey         String? // soft ref to PricingPlan.key
  planStatus      PlanStatus @default(NONE)
  planActivatedAt DateTime?
  planExpiresAt   DateTime? // null = unlimited / none
  planIsCustom    Boolean    @default(false)
  planGrantedById String? // PlatformAdmin.id that last set the plan
  /// Knowledge Vault Employee Perk: an internal organization, created by one of our own
  /// super-admins for staff use. It keeps its content in OUR database via the inline
  /// adapter instead of bringing its own storage, so the storage step is skipped
  /// entirely. Both requesting and creating one require a super-admin username and
  /// password, which is what keeps the perk internal.
  isKvep          Boolean    @default(false)
  /// Optional organization logo — a client-downscaled data URL, same shape as
  /// Profile.avatar. Absent means the UI falls back to the first letter of the name.
  logo            String?
  memberLimit     Int? // per-org cap (customisable by the admin); null = use the plan's limit
  documentLimit   Int? // per-org cap on Studio documents; null = use the plan's limit
  uploadLimit     Int? // per-org cap on uploads/links; null = use the plan's limit
  storageLimitMb  Int? // per-org storage ceiling in MB; null = use the plan's limit
  roles          RoleNode[]
  memberships    Membership[]
  courses        Course[]
  studioDrafts   StudioDraft[]
  supremeAudits  SupremeAudit[]
  storage        OrgStorage?
}

// Audit trail of Supreme-gate activity — the Supreme itself performs no actions, so every
// use of its password is recorded (docs/architecture.md §8).
model SupremeAudit {
  id             String       @id @default(uuid())
  orgId          String
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  action         String // verify_success | verify_failed | owner_added | owner_removed
  actorProfileId String?
  ip             String?
  detail         String?
  createdAt      DateTime     @default(now())

  @@index([orgId, createdAt])
}

model RoleNode {
  id           String       @id @default(uuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id])
  parentId     String? // null only for the Owner role
  name         String // "HR", "Owner", "CEO", …
  roleNumber   Int // unique within org, NEVER reused
  isPublic     Boolean      @default(true) // public by default; hiding is the explicit
  // choice. EFFECTIVE visibility also requires every ancestor below the root to be
  // public — hidden inherits down to the last end. Owners above a hidden node always
  // still see it (hierarchy transparency).
  path         String // materialized path built from role numbers, e.g. "100.101"
  nextItemNumber Int        @default(1) // per-role course item counter, NEVER reused
  placements   Placement[]

  @@unique([orgId, roleNumber])
  @@index([orgId, path])
}

model Membership {
  id         String       @id @default(uuid())
  profileId  String
  profile    Profile      @relation(fields: [profileId], references: [id])
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id])
  createdAt  DateTime     @default(now())
  placements Placement[]

  @@unique([profileId, orgId])
}

model Placement {
  id                 String        @id @default(uuid())
  membershipId       String
  membership         Membership    @relation(fields: [membershipId], references: [id])
  roleNodeId         String
  roleNode           RoleNode      @relation(fields: [roleNodeId], references: [id])
  kind               PlacementKind
  canCreateSubgroups Boolean       @default(false) // meaningful for OWNER
  canAddCoOwners     Boolean       @default(false) // OWNER only: may appoint co-owners here
  canCreateContent   Boolean       @default(false) // MEMBER: may propose content (needs review)
  addedByProfileId   String // escalation target (docs/structure.md §3.4)
  createdAt          DateTime      @default(now())

  @@unique([membershipId, roleNodeId, kind])
}

// ── Courses ────────────────────────────────────────────────────────────────

model Course {
  id                       String             @id @default(uuid())
  orgId                    String
  org                      Organization       @relation(fields: [orgId], references: [id])
  code                     String             @unique // "456-989-0001"
  uploaderRoleNodeId       String
  createdByProfileId       String
  kind                     CourseKind
  title                    String
  description              String? // short description shown in the library and admin views
  inLibrary                Boolean            @default(false) // discoverable in the org library
  category                 String? // dynamic shelf tag ("AI", "Safety", …) — suggested from
  // existing categories at upload time, always changeable by the uploader
  scope                    String? // page-2 "scope" of the standardized document format
  classification           Classification     @default(CONFIDENTIAL) // compulsory org standard
  allowDownload            Boolean            @default(false) // owner-controlled download from preview
  archived                 Boolean            @default(false) // archived: kept, but reaches nobody new
  draft                    Boolean            @default(false) // member proposal pending manager review
  // Taken out of deployment while a new edition is prepared: it reaches nobody and leaves
  // the library, its placements are kept intact, and publishing the edit puts it back and
  // bumps `version` (docs/structure.md §3.8).
  withdrawn                Boolean            @default(false)
  withdrawnAt              DateTime?
  // Where the content came from — drives the plan's separate allowances for documents
  // built in the Studio vs. documents brought in as a file/link. Derived from storageRef
  // at creation so quota counting is a plain indexed query.
  source                   ContentSource      @default(UPLOAD)
  storageRef               Json // adapter-specific pointer: {adapter:"inline"|"link", ...}
  deadlineDays             Int?
  retakeEveryNDays         Int? // recurrence, applies to all kinds
  resetsCompletionOnUpdate Boolean            @default(false)
  version                  Int                @default(1)
  createdAt                DateTime           @default(now())
  placements               CoursePlacement[]
  prerequisites            CoursePrerequisite[] @relation("course")
  requiredBy               CoursePrerequisite[] @relation("requires")
  adminAccess              CourseAdminAccess[]
  reviews                  CourseReview[]
  examAttempts             ExamAttempt[]
}

// One sitting of an MCQ exam. Marking happens on the server (the answer key never leaves
// it), and a passing attempt writes the ordinary CompletionRecord — so an exam reaches the
// compliance views through exactly the same door a document does.
model ExamAttempt {
  id            String   @id @default(uuid())
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id])
  profileId     String
  orgId         String
  /// Version of the exam that was sat — an edited paper doesn't rewrite history.
  courseVersion Int      @default(1)
  /// Per-question outcome: [{ questionId, optionIds, correct, points, earned }]
  answers       Json
  earnedPoints  Float
  totalPoints   Float
  scorePercent  Int
  passed        Boolean
  seconds       Int? // how long the candidate took, when the client reported it
  /// Times the candidate left the paper for longer than the invigilator allows.
  violations    Int      @default(0)
  /// True when the invigilator handed the paper in (third interruption, or time up).
  autoSubmitted Boolean  @default(false)
  /// Set when a manager resets a candidate's attempts: the sitting stays on record but
  /// stops counting against the allowance, so "attempts used" returns to zero without
  /// erasing what happened.
  voided        Boolean  @default(false)
  voidedAt      DateTime?
  voidedByProfileId String?
  submittedAt   DateTime @default(now())

  @@index([courseId, profileId])
  @@index([orgId, submittedAt])
}

model CoursePlacement {
  id                   String   @id @default(uuid())
  courseId             String
  course               Course   @relation(fields: [courseId], references: [id])
  roleNodeId           String
  mandatory            Boolean
  inheritToDescendants Boolean
  deadlineDays         Int? // per-branch override of the course default
  retakeEveryNDays     Int? // per-branch recurrence override
  placedByProfileId    String
  createdAt            DateTime @default(now()) // deadline anchor

  @@unique([courseId, roleNodeId])
}

// A Studio work-in-progress document, parked on the server so the author can leave the
// page and resume from any device. Nothing here is visible to readers — a draft becomes a
// Course only when the author publishes (or submits it for review). Premium capability:
// plans with allowDrafts = false refuse the save (docs/pricing.md).
model StudioDraft {
  id            String       @id @default(uuid())
  orgId         String
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  roleNodeId    String // the branch the document is being written for
  authorProfileId String
  title         String       @default("")
  /// The whole StudioDocument (metadata + blocks) as validated JSON.
  document      Json
  blockCount    Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([orgId, authorProfileId, updatedAt])
}

// Inline storage adapter backend: small files kept in Postgres (free-tier friendly).
// Media at scale goes through other adapters (Drive/NAS/S3 — the port stays open).
model StoredFile {
  id        String   @id @default(uuid())
  orgId     String
  filename  String
  mime      String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  @@index([orgId])
}

model CoursePrerequisite {
  courseId         String
  course           Course @relation("course", fields: [courseId], references: [id])
  requiresCourseId String
  requires         Course @relation("requires", fields: [requiresCourseId], references: [id])

  @@id([courseId, requiresCourseId])
}

model CourseAdminAccess {
  id        String      @id @default(uuid())
  courseId  String
  course    Course      @relation(fields: [courseId], references: [id])
  profileId String
  level     AccessLevel
  canGrant  Boolean // 2-layer tree: may add more people to this page
  grantedBy String

  @@unique([courseId, profileId])
}

// After completing a course a member may rate it (1–5, optional) and leave a comment
// other members see on the library detail view.
model CourseReview {
  id        String   @id @default(uuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  profileId String
  rating    Int? // 1..5, optional
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, profileId])
  @@index([courseId])
}

// ── Compliance ─────────────────────────────────────────────────────────────

// Part of the USER's data, keyed by course code (docs/structure.md §3.7).
model CompletionRecord {
  id            String           @id @default(uuid())
  courseId      String
  courseCode    String // denormalized platform-unique code, survives exports
  profileId     String
  orgId         String
  status        CompletionStatus
  completedAt   DateTime?
  validUntil    DateTime? // expiry: completedAt + retakeEveryNDays
  courseVersion Int
  // exam fields (score, pass/fail, re-attempt time) join here post-v1

  @@index([profileId, orgId])
  @@index([courseCode])
}

// Pending placements for usernames without a profile yet — used by .main revival
// (pending members re-attach when that username registers).
model Invitation {
  id                 String        @id @default(uuid())
  orgId              String
  username           String
  roleNodeId         String
  kind               PlacementKind
  canCreateSubgroups Boolean       @default(false)
  canAddCoOwners     Boolean       @default(false)
  canCreateContent   Boolean       @default(false)
  invitedByProfileId String
  acceptedAt         DateTime?
  createdAt          DateTime      @default(now())

  @@index([username])
  @@index([orgId, roleNodeId])
}

// Every ask-and-approve flow on the platform: course requests from the library,
// join requests to public branches, and branch-deletion requests to the layer above.
model VaultRequest {
  id                 String        @id @default(uuid())
  orgId              String
  kind               RequestKind
  status             RequestStatus @default(PENDING)
  requesterProfileId String
  targetRoleNodeId   String // branch to join / branch to delete / branch receiving the course
  joinAs             PlacementKind @default(MEMBER) // JOIN_BRANCH only: member or sub-owner
  courseId           String? // COURSE_ASSIGN only
  message            String?
  decidedByProfileId String?
  decidedAt          DateTime?
  decisionNote       String?
  createdAt          DateTime      @default(now())

  @@index([orgId, status])
  @@index([requesterProfileId])
}

// One message in a profile's mailbox. Written through notify()/notifyFromAdmin(), which
// stamp the folder (category), the flag (priority) and the deletion date (expiresAt) from
// the shared catalog in @vault/shared/notifications — so retention is a property of the
// row, not a rule scattered across sweeps. Reads are always
// (profileId → category/priority → createdAt), which is exactly what the indexes serve.
model Notification {
  id        String    @id @default(uuid())
  profileId String
  orgId     String?
  kind      String
  /** Mailbox folder: ADMIN | PLAN | REQUESTS | CONTENT | LEARNING | PEOPLE | SYSTEM. */
  category  String    @default("SYSTEM")
  /** HIGH | NORMAL | LOW — admin mail is always HIGH and sorts to the top. */
  priority  String    @default("NORMAL")
  /** Subject line, stored so the list renders without re-deriving it per row. */
  subject   String    @default("")
  /** Body text shown in the reading pane. */
  body      String    @default("")
  payload   Json
  readAt    DateTime?
  /** The sweeper deletes the row after this instant; the mailbox counts it down. */
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([profileId, readAt])
  @@index([profileId, createdAt])
  @@index([profileId, category, createdAt])
  @@index([expiresAt])
}

// ── Pricing, plans, coins & the platform (super-super-admin) realm ───────────
// Everything below powers the paywall: dynamic pricing cards, Knowledge Coins,
// the OTP-gated create/upgrade request flow, and the platform-admin console.
// See docs/pricing.md for the full contract.

enum PlanStatus {
  NONE // legacy / grandfathered org — no timer, no restriction
  DEMO // free trial, capped (default 2 months)
  ACTIVE // paid plan in effect
  EXPIRED // plan lapsed — org is locked pending upgrade
}

enum PlatformRequestKind {
  CREATE_ORG // permission (OTP) to create a new organization on a chosen plan
  CUSTOM_PLAN // user proposes their own days + coin offer; admin negotiates
  RESTORE_ORG // key to restore an expired/purged org from its .main
  UPGRADE_PLAN // move an existing organization onto a higher plan
  KVEP_ORG // Knowledge Vault Employee Perk — an internal organization on OUR storage
}

enum PlatformRequestStatus {
  PENDING
  APPROVED
  DENIED
  USED
  EXPIRED
  WITHDRAWN
}

enum CoinTxnReason {
  SIGNUP_GRANT
  ADMIN_GIFT
  ADMIN_DEDUCT
  PLAN_SPEND
  REFUND
}

// The dynamic pricing table: one active row = one card; `category` is the tab it
// sits under, so adding a row (or a new category) changes the Pricing page with no
// code change. Offers use validFrom/validUntil to appear only inside their window.
model PricingPlan {
  id           String    @id @default(uuid())
  key          String    @unique // stable code, e.g. "demo" | "monthly" | "organisation"
  name         String
  tagline      String?
  category     String    @default("Plans") // the tab: "Plans" | "Offers" | "Student" | …
  priceCoins   Int       @default(0) // 0 = free (demo)
  durationDays Int? // null = admin-set / unlimited
  memberLimit  Int? // max people in an org on this plan; null = unlimited / admin-set
  documentLimit Int? // max Studio-authored documents; null = unlimited / admin-set
  uploadLimit   Int? // max uploaded or linked documents; null = unlimited / admin-set
  storageLimitMb Int? // total stored bytes allowed, in MB; null = unlimited
  /** Rank in the upgrade ladder — the Pricing page uses it to say what is "above" a plan. */
  tier          Int      @default(0)
  allowDrafts   Boolean  @default(true) // may authors park work-in-progress Studio drafts?
  isCustom     Boolean   @default(false) // user proposes days + coins; admin decides
  imageUrl     String? // data-URL or external image for the card
  criteria     String? // eligibility text ("valid student ID", …)
  badge        String? // "Popular", "Best value"
  highlights   Json? // string[] of bullet features
  active       Boolean   @default(true)
  sortOrder    Int       @default(100)
  validFrom    DateTime? // offer visibility window (null = always)
  validUntil   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([category, active, sortOrder])
}

// Platform (super-super-admin) accounts — a SEPARATE auth realm from Profile.
// Seeded with the first admin `admin-kwbase`. God-mode; every action is audited.
model PlatformAdmin {
  id                 String   @id @default(uuid())
  username           String   @unique
  passwordHash       String // Argon2id
  displayName        String
  active             Boolean  @default(true)
  mustChangePassword Boolean  @default(true)
  createdById        String? // PlatformAdmin.id that added this one
  createdAt          DateTime @default(now())
  lastLoginAt        DateTime?
}

// The request↔response channel between a user and the super-admin. Covers the
// OTP-gated org creation, the custom days+coins negotiation, and restore keys.
// The 8-char code is stored only as a hash; it expires 24h after approval.
model PlatformRequest {
  id              String                @id @default(uuid())
  kind            PlatformRequestKind
  status          PlatformRequestStatus @default(PENDING)
  requesterId     String
  requester       Profile               @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  planKey         String? // chosen plan (null for a pure custom proposal)
  requestedDays   Int? // custom: days the user wants
  offeredCoins    Int? // custom: coins the user offers
  // Custom/organisational proposals also carry the shape of the org they need, so the
  // admin approves numbers the user already stated instead of inventing them.
  requestedMembers   Int?
  requestedDocuments Int? // custom documents built in the Studio
  requestedUploads   Int? // uploaded/linked documents
  message         String? // the user's note
  // ── decision (filled by the admin) ──
  grantedDays     Int?
  grantedMembers  Int?
  grantedDocuments Int?
  grantedUploads  Int?
  priceCoins      Int?
  otpHash         String? // hashed 8-char alphanumeric code
  otpExpiresAt    DateTime?
  adminMessage    String? // custom approval/denial message
  decidedById     String? // PlatformAdmin.id
  decidedAt       DateTime?
  targetOrgNumber Int? // RESTORE_ORG: which org this key restores
  usedAt          DateTime?
  createdAt       DateTime              @default(now())

  @@index([requesterId, status])
  @@index([status, createdAt])
}

// Knowledge Coin ledger — every grant, spend, gift and adjustment, with the
// resulting balance snapshot for a clean audit trail.
model CoinTransaction {
  id        String        @id @default(uuid())
  profileId String
  profile   Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  delta     Int // +/- coins
  balance   Int // resulting balance after this txn
  reason    CoinTxnReason
  note      String?
  byAdminId String? // PlatformAdmin.id when a gift/adjustment
  createdAt DateTime      @default(now())

  @@index([profileId, createdAt])
}

// Platform-wide settings the super-admin can tune (e.g. default_coins for new profiles).
model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ── Organization-provided storage (docs/structure.md §9) ─────────────────────
// The organization's own S3-compatible backend (MinIO on their NAS today; S3, R2,
// GCS, Wasabi, B2 and Spaces are the same adapter with a different endpoint).
// Secrets are encrypted with STORAGE_KEK, which lives in the environment and NEVER
// in this database — a dump alone must not reach a customer's storage.

enum StorageStatus {
  UNCONFIGURED // no backend connected: the org still uses the inline adapter
  ACTIVE // last health check passed
  DEGRADED // unreachable or refusing us — read-only, never "data loss" (§9.8)
}

enum EncryptionPosture {
  ENCRYPTED // objects land as opaque .kvblob ciphertext (default)
  PLAIN // objects land as ordinary readable files, by the org's informed choice
}

model OrgStorage {
  id      String       @id @default(uuid())
  orgId   String       @unique
  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  adapter String       @default("s3") // the only backend today; the dropdown shows it as "NAS"

  // ── Non-secret connection config ──
  endpoint       String // https://storage.acme.com — their MinIO address
  bucket         String
  region         String  @default("us-east-1") // MinIO ignores it; real S3 needs it
  prefix         String  @default("") // lets them share a bucket with other systems
  forcePathStyle Boolean @default(true) // MinIO needs this on

  // ── Secrets, sealed with STORAGE_KEK (see storage/secrets.ts) ──
  accessKeyIdEnc String
  secretKeyEnc   String

  // The org's data key, wrapped by the platform KEK. The Supreme-wrapped copy is
  // computed at .main export time and deliberately NEVER stored (§9.5).
  wrappedDek String?

  status      StorageStatus     @default(UNCONFIGURED)
  encryption  EncryptionPosture @default(ENCRYPTED)
  lastCheckAt DateTime?
  lastError   String? // the precise reason the last check failed, shown to owners
  degradedAt  DateTime? // when it entered DEGRADED — compliance pauses from here (§9.8)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One row per object we hold in the organization's storage. Unlike StoredFile this
// carries a real course link and an integrity hash, so orphan collection is an
// indexed query rather than a scan of every course's storageRef JSON.
model StorageObject {
  id        String  @id @default(uuid())
  orgId     String
  objectKey String // objects/2026/08/<hash>.kvblob — relative to the configured prefix
  sha256    String // of the PLAINTEXT, verified after decryption (§9.4)
  bytes     Int // plaintext size — what the user downloads and what quota counts
  mime      String
  filename  String
  encrypted Boolean @default(true)
  /// This object's file key, wrapped under the org DEK. Null when encryption is PLAIN.
  /// Every object gets its own key, so one compromised file never unlocks the next.
  wrappedKey String?
  courseId  String? // null while a course is mid-create, or for orphans awaiting collection
  createdAt DateTime @default(now())

  @@unique([orgId, objectKey])
  @@index([orgId])
  @@index([courseId])
}

// Durable delete queue. A remote delete cannot run inside a Postgres transaction, so
// course deletion commits a queue row with the transaction and the drain runs after
// it, with retries (§9.10).
model StorageDeletion {
  id        String   @id @default(uuid())
  orgId     String
  objectKey String
  attempts  Int      @default(0)
  lastError String?
  nextTryAt DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([nextTryAt])
  @@index([orgId])
}

// Append-only audit of every super-admin action (god-mode needs a trail).
model PlatformAdminAudit {
  id        String   @id @default(uuid())
  adminId   String
  action    String // grant_otp | deny_request | gift_coins | upgrade_plan | add_admin | …
  detail    Json?
  createdAt DateTime @default(now())

  @@index([adminId, createdAt])
}
